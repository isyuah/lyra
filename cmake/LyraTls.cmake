include(FetchContent)

function(lyra_add_tls)
    set(runtime "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime")
    add_library(lyraNghttp2 INTERFACE)
    add_library(lyraHttpClient STATIC "${runtime}/http_client.cpp")
    add_library(lyraHttpTls STATIC "${runtime}/http_tls.cpp")
    add_executable(lyraRegistryDownload "${runtime}/registry_download.cpp")
    set_target_properties(lyraRegistryDownload PROPERTIES OUTPUT_NAME lyra-registry-download RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/libexec/lyra")
    install(TARGETS lyraRegistryDownload RUNTIME DESTINATION libexec/lyra)
    foreach(transport IN ITEMS lyraHttpClient lyraHttpTls)
        target_compile_options(${transport} PRIVATE -fno-exceptions -fno-rtti)
        set_target_properties(${transport} PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
    endforeach()
    install(TARGETS lyraHttpClient lyraHttpTls ARCHIVE DESTINATION lib)
    if(WIN32)
        get_target_property(archive BDWgc::gc IMPORTED_LOCATION_RELEASE)
        get_filename_component(prefix "${archive}/../.." ABSOLUTE)
        foreach(name IN ITEMS curl cares nghttp2 ssl crypto zs)
            lyra_stage_sdk_input("${prefix}/lib/lib${name}.a" "lib/lib${name}.a")
        endforeach()
        foreach(port IN ITEMS curl c-ares nghttp2 openssl zlib)
            install(FILES "${prefix}/share/${port}/copyright" DESTINATION "share/lyra/licenses/${port}")
        endforeach()
        target_include_directories(lyraHttpClient SYSTEM PRIVATE "${prefix}/include")
        target_include_directories(lyraHttpTls SYSTEM PRIVATE "${prefix}/include")
        target_include_directories(lyraNghttp2 SYSTEM INTERFACE "${prefix}/include")
        target_compile_definitions(lyraNghttp2 INTERFACE NGHTTP2_STATICLIB)
        target_link_libraries(lyraNghttp2 INTERFACE "${prefix}/lib/libnghttp2.a")
        target_compile_definitions(lyraHttpClient PRIVATE CURL_STATICLIB)
        target_include_directories(lyraRegistryDownload SYSTEM PRIVATE "${prefix}/include")
        target_compile_definitions(lyraRegistryDownload PRIVATE CURL_STATICLIB)
        target_link_options(lyraRegistryDownload PRIVATE -static -municode -fuse-ld=lld)
        target_link_libraries(lyraRegistryDownload PRIVATE "${prefix}/lib/libcurl.a" "${prefix}/lib/libcares.a" lyraNghttp2 "${prefix}/lib/libssl.a"
            "${prefix}/lib/libcrypto.a" "${prefix}/lib/libzs.a" bcrypt crypt32 advapi32 secur32 ws2_32 iphlpapi)
    else()
        set(OPENSSL_USE_STATIC_LIBS TRUE)
        find_package(OpenSSL 3.0 REQUIRED)
        lyra_stage_sdk_input("${OPENSSL_SSL_LIBRARY}" lib/libssl.a)
        lyra_stage_sdk_input("${OPENSSL_CRYPTO_LIBRARY}" lib/libcrypto.a)
        if(EXISTS /usr/share/doc/libssl-dev/copyright)
            file(REAL_PATH /usr/share/doc/libssl-dev/copyright opensslLicense)
            install(FILES "${opensslLicense}" DESTINATION share/lyra/licenses/openssl RENAME copyright)
        endif()

        set(lyraBuildTesting "${BUILD_TESTING}")
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        set(BUILD_TESTING OFF)
        set(CARES_STATIC ON)
        set(CARES_SHARED OFF)
        set(CARES_INSTALL OFF)
        set(CARES_BUILD_TOOLS OFF)
        FetchContent_Declare(lyra_cares
            URL https://codeload.github.com/c-ares/c-ares/tar.gz/refs/tags/v1.34.8
            URL_HASH SHA512=66399b3d053157179fe3df60922a49c780bfd7e31fd853dc530b36e430c82534018a06b76f779b31554e088749083ca04dfeaa60301c1f1b9d96eba888790fa0
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(lyra_cares)

        set(BUILD_SHARED_LIBS OFF)
        set(BUILD_STATIC_LIBS ON)
        set(CMAKE_DEBUG_POSTFIX "")
        set(ENABLE_LIB_ONLY ON)
        set(ENABLE_APP OFF)
        set(ENABLE_EXAMPLES OFF)
        set(ENABLE_HPACK_TOOLS OFF)
        set(ENABLE_DOC OFF)
        set(ENABLE_FAILMALLOC OFF)
        FetchContent_Declare(lyra_nghttp2
            URL https://codeload.github.com/nghttp2/nghttp2/tar.gz/refs/tags/v1.70.0
            URL_HASH SHA512=f5f35fdbbf289bb810ce2cc6260cd1d5fb0f72d886d6f0939924fd098715d2aec9ca8c05d3c4fdaf107fc675897af2033785a0c41a04220d2e9fb335807c770a
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(lyra_nghttp2)
        if(NOT TARGET nghttp2_static)
            message(FATAL_ERROR "Missing static nghttp2 source. For a disconnected build, set FETCHCONTENT_SOURCE_DIR_LYRA_NGHTTP2 to the extracted nghttp2 1.70.0 directory.")
        endif()
        set_target_properties(nghttp2_static PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
        target_link_libraries(lyraNghttp2 INTERFACE nghttp2_static)
        install(TARGETS nghttp2_static ARCHIVE DESTINATION lib)
        install(FILES "${lyra_nghttp2_SOURCE_DIR}/COPYING" DESTINATION share/lyra/licenses/nghttp2)
        set(NGHTTP2_INCLUDE_DIR "${lyra_nghttp2_BINARY_DIR}/lib/includes")
        set(NGHTTP2_LIBRARY nghttp2_static)
        set(NGHTTP2_USE_STATIC_LIBS ON)
        set(ZLIB_USE_STATIC_LIBS TRUE)
        find_library(lyraTlsZlibArchive NAMES libz.a REQUIRED)
        set(ZLIB_LIBRARY_RELEASE "${lyraTlsZlibArchive}")
        set(ZLIB_LIBRARY_DEBUG "${lyraTlsZlibArchive}")
        find_package(ZLIB REQUIRED)
        set_target_properties(ZLIB::ZLIB PROPERTIES IMPORTED_LOCATION "${lyraTlsZlibArchive}"
            IMPORTED_LOCATION_RELEASE "${lyraTlsZlibArchive}" IMPORTED_LOCATION_DEBUG "${lyraTlsZlibArchive}")
        set(BUILD_CURL_EXE OFF)
        set(BUILD_LIBCURL_DOCS OFF)
        set(BUILD_MISC_DOCS OFF)
        set(ENABLE_CURL_MANUAL OFF)
        set(CURL_DISABLE_INSTALL ON)
        set(CURL_USE_OPENSSL ON)
        set(CURL_USE_PKGCONFIG OFF)
        set(CURL_USE_CMAKECONFIG OFF)
        set(CURL_ZLIB ON CACHE STRING "Build curl with static zlib support" FORCE)
        set(CURL_ZSTD OFF CACHE STRING "Disable unbundled zstd support" FORCE)
        set(CURL_BROTLI OFF CACHE STRING "Disable unbundled Brotli support" FORCE)
        set(USE_LIBIDN2 OFF)
        set(CURL_USE_LIBPSL OFF)
        set(CURL_USE_LIBSSH2 OFF)
        set(USE_NGHTTP2 ON)
        foreach(protocol IN ITEMS DICT FILE FTP GOPHER IMAP IPFS LDAP LDAPS MQTT POP3 RTSP SMTP TELNET TFTP WEBSOCKETS)
            set(CURL_DISABLE_${protocol} ON)
        endforeach()
        set(ENABLE_THREADED_RESOLVER OFF)
        set(ENABLE_ARES ON)
        set(CARES_USE_STATIC_LIBS ON)
        set(CARES_INCLUDE_DIR "${lyra_cares_SOURCE_DIR}/include")
        set(CARES_LIBRARY c-ares::cares)
        set(CURL_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt CACHE STRING "System CA bundle for the Linux SDK" FORCE)
        set(CURL_CA_PATH none CACHE STRING "Disable a separate CA directory" FORCE)
        FetchContent_Declare(lyra_curl
            URL https://codeload.github.com/curl/curl/tar.gz/refs/tags/curl-8_23_0
            URL_HASH SHA512=e1003f374675a6ae50463995a6c705208c4247120093f1fcccf030847161235b3dfc0e40927114ccbc5b4530893990ccb96ec15400ffe4bcb275d26a0499f10e
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(lyra_curl)
        set(BUILD_TESTING "${lyraBuildTesting}" CACHE BOOL "Build tests" FORCE)
        set_target_properties(libcurl_static c-ares PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
        set_target_properties(c-ares PROPERTIES OUTPUT_NAME cares)
        install(TARGETS libcurl_static c-ares ARCHIVE DESTINATION lib)
        install(FILES "${lyra_curl_SOURCE_DIR}/COPYING" DESTINATION share/lyra/licenses/curl)
        install(FILES "${lyra_cares_SOURCE_DIR}/LICENSE.md" DESTINATION share/lyra/licenses/c-ares)
        target_link_libraries(lyraHttpClient PRIVATE libcurl_static OpenSSL::SSL)
        target_link_libraries(lyraHttpTls PRIVATE OpenSSL::SSL)
        target_link_options(lyraRegistryDownload PRIVATE -static-libstdc++ -static-libgcc)
        target_link_libraries(lyraRegistryDownload PRIVATE libcurl_static OpenSSL::SSL)
    endif()
endfunction()
