include(FetchContent)

function(lyra_add_tls)
    set(runtime "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime")
    add_library(lyraHttpClient STATIC "${runtime}/http_client.cpp")
    add_library(lyraHttpTls STATIC "${runtime}/http_tls.cpp")
    foreach(transport IN ITEMS lyraHttpClient lyraHttpTls)
        target_compile_options(${transport} PRIVATE -fno-exceptions -fno-rtti)
        set_target_properties(${transport} PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
    endforeach()
    install(TARGETS lyraHttpClient lyraHttpTls ARCHIVE DESTINATION lib)
    if(WIN32)
        get_target_property(archive BDWgc::gc IMPORTED_LOCATION_RELEASE)
        get_filename_component(prefix "${archive}/../.." ABSOLUTE)
        foreach(name IN ITEMS curl cares ssl crypto zs)
            lyra_stage_sdk_input("${prefix}/lib/lib${name}.a" "lib/lib${name}.a")
        endforeach()
        foreach(port IN ITEMS curl c-ares openssl zlib)
            install(FILES "${prefix}/share/${port}/copyright" DESTINATION "share/lyra/licenses/${port}")
        endforeach()
        target_include_directories(lyraHttpClient SYSTEM PRIVATE "${prefix}/include")
        target_include_directories(lyraHttpTls SYSTEM PRIVATE "${prefix}/include")
        target_compile_definitions(lyraHttpClient PRIVATE CURL_STATICLIB)
    else()
        set(OPENSSL_USE_STATIC_LIBS TRUE)
        find_package(OpenSSL 3.0 REQUIRED)
        lyra_stage_sdk_input("${OPENSSL_SSL_LIBRARY}" lib/libssl.a)
        lyra_stage_sdk_input("${OPENSSL_CRYPTO_LIBRARY}" lib/libcrypto.a)
        if(EXISTS /usr/share/doc/libssl-dev/copyright)
            file(REAL_PATH /usr/share/doc/libssl-dev/copyright opensslLicense)
            install(FILES "${opensslLicense}" DESTINATION share/lyra/licenses/openssl RENAME copyright)
        endif()

        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        set(BUILD_TESTING OFF)
        set(CARES_STATIC ON)
        set(CARES_SHARED OFF)
        set(CARES_INSTALL OFF)
        set(CARES_BUILD_TOOLS OFF)
        FetchContent_Declare(lyra_cares
            URL https://codeload.github.com/c-ares/c-ares/tar.gz/refs/tags/v1.34.8
            URL_HASH SHA512=66399b3d053157179fe3df60922a49c780bfd7e31fd853dc530b36e430c82534018a06b76f779b31554e088749083ca04dfeaa60301c1f1b9d96eba888790fa0
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(lyra_cares)

        set(BUILD_SHARED_LIBS OFF)
        set(BUILD_STATIC_LIBS ON)
        set(BUILD_CURL_EXE OFF)
        set(BUILD_LIBCURL_DOCS OFF)
        set(BUILD_MISC_DOCS OFF)
        set(CMAKE_DEBUG_POSTFIX "")
        set(ENABLE_CURL_MANUAL OFF)
        set(CURL_DISABLE_INSTALL ON)
        set(CURL_USE_OPENSSL ON)
        set(CURL_USE_PKGCONFIG OFF)
        set(CURL_USE_CMAKECONFIG OFF)
        set(CURL_ZLIB OFF)
        set(CURL_ZSTD OFF)
        set(CURL_BROTLI OFF)
        set(CURL_USE_LIBPSL OFF)
        set(CURL_USE_LIBSSH2 OFF)
        set(USE_NGHTTP2 OFF)
        foreach(protocol IN ITEMS DICT FILE FTP GOPHER IMAP IPFS LDAP LDAPS MQTT POP3 RTSP SMTP TELNET TFTP WEBSOCKETS)
            set(CURL_DISABLE_${protocol} ON)
        endforeach()
        set(ENABLE_THREADED_RESOLVER OFF)
        set(ENABLE_ARES ON)
        set(CARES_USE_STATIC_LIBS ON)
        set(CARES_INCLUDE_DIR "${lyra_cares_SOURCE_DIR}/include")
        set(CARES_LIBRARY c-ares::cares)
        set(CURL_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt)
        set(CURL_CA_PATH none)
        FetchContent_Declare(lyra_curl
            URL https://codeload.github.com/curl/curl/tar.gz/refs/tags/curl-8_23_0
            URL_HASH SHA512=e1003f374675a6ae50463995a6c705208c4247120093f1fcccf030847161235b3dfc0e40927114ccbc5b4530893990ccb96ec15400ffe4bcb275d26a0499f10e
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(lyra_curl)
        set_target_properties(libcurl_static c-ares PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
        set_target_properties(c-ares PROPERTIES OUTPUT_NAME cares)
        install(TARGETS libcurl_static c-ares ARCHIVE DESTINATION lib)
        install(FILES "${lyra_curl_SOURCE_DIR}/COPYING" DESTINATION share/lyra/licenses/curl)
        install(FILES "${lyra_cares_SOURCE_DIR}/LICENSE.md" DESTINATION share/lyra/licenses/c-ares)
        target_link_libraries(lyraHttpClient PRIVATE libcurl_static OpenSSL::SSL)
        target_link_libraries(lyraHttpTls PRIVATE OpenSSL::SSL)
    endif()
endfunction()
