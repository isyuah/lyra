function(lyra_stage_standard_library)
    set(source "${CMAKE_CURRENT_SOURCE_DIR}/std")
    file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" binary)
    set(stage "${binary}/share/lyra/std")
    file(REAL_PATH "${stage}" resolved)
    if(NOT resolved STREQUAL stage OR IS_SYMLINK "${stage}")
        message(FATAL_ERROR "Refusing to stage the standard library through a symlink: ${stage}")
    endif()

    file(GLOB_RECURSE standardSources CONFIGURE_DEPENDS RELATIVE "${source}" "${source}/*.ly")
    file(GLOB_RECURSE staged LIST_DIRECTORIES TRUE RELATIVE "${stage}" "${stage}/*")
    list(SORT staged ORDER DESCENDING)
    foreach(entry IN LISTS staged)
        set(path "${stage}/${entry}")
        if(IS_SYMLINK "${path}")
            file(REMOVE "${path}")
        elseif(IS_DIRECTORY "${path}")
            file(GLOB contents "${path}/*")
            if(NOT contents AND NOT entry IN_LIST standardSources)
                file(REAL_PATH "${path}" resolvedEntry)
                if(NOT resolvedEntry STREQUAL path)
                    message(FATAL_ERROR "Refusing to remove a staging directory outside ${stage}: ${path}")
                endif()
                file(REMOVE_RECURSE "${path}")
            endif()
        elseif(NOT entry IN_LIST standardSources)
            file(REMOVE "${path}")
        endif()
    endforeach()
    foreach(entry IN LISTS standardSources)
        configure_file("${source}/${entry}" "${stage}/${entry}" COPYONLY)
    endforeach()
    foreach(entry IN LISTS standardSources)
        get_filename_component(directory "${entry}" DIRECTORY)
        install(FILES "${source}/${entry}" DESTINATION "share/lyra/std/${directory}")
    endforeach()
endfunction()

function(lyra_install_linux_notice source)
    find_program(dpkgQuery NAMES dpkg-query)
    if(dpkgQuery)
        execute_process(COMMAND "${dpkgQuery}" -S "${source}" OUTPUT_VARIABLE owner RESULT_VARIABLE status
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(status EQUAL 0 AND owner MATCHES "^([^:]+):")
            set(package "${CMAKE_MATCH_1}")
            set(license "/usr/share/doc/${package}/copyright")
            if(EXISTS "${license}")
                install(FILES "${license}" DESTINATION "share/lyra/licenses/host/${package}")
            endif()
        endif()
    endif()
endfunction()

function(lyra_stage_sdk_input source name)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Missing SDK input: ${source}")
    endif()
    get_filename_component(directory "${name}" DIRECTORY)
    configure_file("${source}" "${CMAKE_BINARY_DIR}/${name}" COPYONLY)
    install(FILES "${CMAKE_BINARY_DIR}/${name}" DESTINATION "${directory}")
endfunction()

function(lyra_stage_linker source name)
    configure_file("${source}" "${CMAKE_BINARY_DIR}/libexec/lyra/${name}" COPYONLY)
    install(PROGRAMS "${CMAKE_BINARY_DIR}/libexec/lyra/${name}" DESTINATION libexec/lyra)
endfunction()

function(lyra_stage_linux_sdk)
    find_program(LYRA_LLD NAMES ld.lld-18 ld.lld HINTS "${LLVM_TOOLS_BINARY_DIR}" REQUIRED)
    lyra_stage_linker("${LYRA_LLD}" ld.lld)
    foreach(input IN ITEMS Scrt1.o crti.o crtbeginS.o crtendS.o crtn.o libgcc.a libgcc_eh.a libstdc++.a libc.so.6 libc_nonshared.a libm.so.6)
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "--print-file-name=${input}"
            OUTPUT_VARIABLE source OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        lyra_stage_sdk_input("${source}" "lib/lyra/target/${input}")
        file(REAL_PATH "${source}" realSource)
        lyra_install_linux_notice("${realSource}")
    endforeach()

    get_target_property(llvm LLVM IMPORTED_LOCATION)
    get_target_property(configurations LLVM IMPORTED_CONFIGURATIONS)
    foreach(configuration IN LISTS configurations)
        if(llvm)
            break()
        endif()
        get_target_property(llvm LLVM "IMPORTED_LOCATION_${configuration}")
    endforeach()
    if(NOT EXISTS "${llvm}")
        message(FATAL_ERROR "The Linux SDK needs a shared LLVM 18 installation alongside LLD.")
    endif()
    set(hostDependencies "${CMAKE_BINARY_DIR}/lyra-host-dependencies.cmake")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DLINKER=${LYRA_LLD}" "-DLLVM=${llvm}" "-DOUTPUT=${hostDependencies}"
        -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/LyraLinuxHost.cmake" COMMAND_ERROR_IS_FATAL ANY)
    include("${hostDependencies}")
    foreach(dependency IN LISTS dependencies)
        get_filename_component(name "${dependency}" NAME)
        lyra_stage_sdk_input("${dependency}" "lib/lyra/host/${name}")
        lyra_install_linux_notice("${dependency}")
    endforeach()
    foreach(tool IN ITEMS "${LYRA_LLD}" "${llvm}")
        lyra_install_linux_notice("${tool}")
    endforeach()
endfunction()
