function(lyra_stage_sdk_input source name)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Missing SDK input: ${source}")
    endif()
    get_filename_component(directory "${name}" DIRECTORY)
    configure_file("${source}" "${CMAKE_BINARY_DIR}/${name}" COPYONLY)
    install(FILES "${CMAKE_BINARY_DIR}/${name}" DESTINATION "${directory}")
endfunction()

function(lyra_stage_linker source name)
    configure_file("${source}" "${CMAKE_BINARY_DIR}/libexec/lyra/${name}" COPYONLY)
    install(PROGRAMS "${CMAKE_BINARY_DIR}/libexec/lyra/${name}" DESTINATION libexec/lyra)
endfunction()

function(lyra_stage_linux_sdk)
    find_program(LYRA_LLD NAMES ld.lld-18 ld.lld HINTS "${LLVM_TOOLS_BINARY_DIR}" REQUIRED)
    lyra_stage_linker("${LYRA_LLD}" ld.lld)
    foreach(input IN ITEMS Scrt1.o crti.o crtbeginS.o crtendS.o crtn.o libgcc.a libc.so.6 libc_nonshared.a libm.so.6)
        execute_process(COMMAND "${CMAKE_C_COMPILER}" "--print-file-name=${input}"
            OUTPUT_VARIABLE source OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        lyra_stage_sdk_input("${source}" "lib/lyra/target/${input}")
    endforeach()

    get_target_property(llvm LLVM IMPORTED_LOCATION)
    get_target_property(configurations LLVM IMPORTED_CONFIGURATIONS)
    foreach(configuration IN LISTS configurations)
        if(llvm)
            break()
        endif()
        get_target_property(llvm LLVM "IMPORTED_LOCATION_${configuration}")
    endforeach()
    if(NOT EXISTS "${llvm}")
        message(FATAL_ERROR "The Linux SDK needs a shared LLVM 18 installation alongside LLD.")
    endif()
    set(hostDependencies "${CMAKE_BINARY_DIR}/lyra-host-dependencies.cmake")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DLINKER=${LYRA_LLD}" "-DLLVM=${llvm}" "-DOUTPUT=${hostDependencies}"
        -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/LyraLinuxHost.cmake" COMMAND_ERROR_IS_FATAL ANY)
    include("${hostDependencies}")
    foreach(dependency IN LISTS dependencies)
        get_filename_component(name "${dependency}" NAME)
        lyra_stage_sdk_input("${dependency}" "lib/lyra/host/${name}")
        find_program(dpkgQuery NAMES dpkg-query)
        if(dpkgQuery)
            execute_process(COMMAND "${dpkgQuery}" -S "${dependency}" OUTPUT_VARIABLE owner RESULT_VARIABLE status
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(status EQUAL 0 AND owner MATCHES "^([^:]+):")
                set(license "${CMAKE_MATCH_1}")
                set(licenseFile "/usr/share/doc/${license}/copyright")
                if(EXISTS "${licenseFile}")
                    install(FILES "${licenseFile}" DESTINATION "share/lyra/licenses/host/${license}")
                endif()
            endif()
        endif()
    endforeach()
    foreach(tool IN ITEMS "${LYRA_LLD}" "${llvm}")
        find_program(dpkgQuery NAMES dpkg-query)
        if(dpkgQuery)
            execute_process(COMMAND "${dpkgQuery}" -S "${tool}" OUTPUT_VARIABLE owner RESULT_VARIABLE status
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(status EQUAL 0 AND owner MATCHES "^([^:]+):")
                set(license "${CMAKE_MATCH_1}")
                set(licenseFile "/usr/share/doc/${license}/copyright")
                if(EXISTS "${licenseFile}")
                    install(FILES "${licenseFile}" DESTINATION "share/lyra/licenses/host/${license}")
                endif()
            endif()
        endif()
    endforeach()
endfunction()
