function(lyra_stage_c_frontend target)
    find_package(Clang ${LLVM_PACKAGE_VERSION} EXACT REQUIRED CONFIG HINTS "${LLVM_LIBRARY_DIRS}/cmake/clang")
    target_include_directories(${target} SYSTEM PRIVATE ${CLANG_INCLUDE_DIRS})

    get_target_property(library libclang IMPORTED_LOCATION)
    get_target_property(configurations libclang IMPORTED_CONFIGURATIONS)
    foreach(configuration IN LISTS configurations)
        if(library)
            break()
        endif()
        get_target_property(library libclang "IMPORTED_LOCATION_${configuration}")
    endforeach()
    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "The Lyra SDK needs the shared Clang frontend (libclang).")
    endif()
    if(WIN32)
        set(name libclang.dll)
    else()
        set(name libclang.so)
    endif()
    set(tools "${CMAKE_BINARY_DIR}/libexec/lyra")
    configure_file("${library}" "${tools}/${name}" COPYONLY)
    install(FILES "${tools}/${name}" DESTINATION libexec/lyra)
    execute_process(COMMAND "${LLVM_TOOLS_BINARY_DIR}/clang${CMAKE_EXECUTABLE_SUFFIX}" -print-resource-dir
        OUTPUT_VARIABLE resource OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT IS_DIRECTORY "${resource}/include")
        message(FATAL_ERROR "Clang resource headers not found: ${resource}/include")
    endif()
    file(COPY "${resource}/include" DESTINATION "${tools}/clang")
    install(DIRECTORY "${tools}/clang/include" DESTINATION libexec/lyra/clang)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        foreach(package IN ITEMS clang-18 libclang1-18 libclang-common-18-dev)
            if(EXISTS "/usr/share/doc/${package}/copyright")
                install(FILES "/usr/share/doc/${package}/copyright" DESTINATION "share/lyra/licenses/host/${package}")
            endif()
        endforeach()
    endif()
endfunction()
