function(lyra_install_c_headers source destination name)
    set(archive "${CMAKE_BINARY_DIR}/${name}.tar")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=gnutar .
        WORKING_DIRECTORY "${source}" COMMAND_ERROR_IS_FATAL ANY)
    file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
    install(CODE "
        set(headerRoot \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${destination}\")
        file(MAKE_DIRECTORY \"\${headerRoot}\")
        file(ARCHIVE_EXTRACT INPUT \"${archive}\" DESTINATION \"\${headerRoot}\")
        foreach(entry IN ITEMS ${entries})
            list(APPEND CMAKE_INSTALL_MANIFEST_FILES \"\${CMAKE_INSTALL_PREFIX}/${destination}/\${entry}\")
        endforeach()
    ")
endfunction()

function(lyra_stage_c_frontend target)
    find_package(Clang ${LLVM_PACKAGE_VERSION} EXACT REQUIRED CONFIG HINTS "${LLVM_LIBRARY_DIRS}/cmake/clang")
    target_include_directories(${target} SYSTEM PRIVATE ${CLANG_INCLUDE_DIRS})

    get_target_property(library libclang IMPORTED_LOCATION)
    get_target_property(configurations libclang IMPORTED_CONFIGURATIONS)
    foreach(configuration IN LISTS configurations)
        if(library)
            break()
        endif()
        get_target_property(library libclang "IMPORTED_LOCATION_${configuration}")
    endforeach()
    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "The Lyra SDK needs the shared Clang frontend (libclang).")
    endif()
    if(WIN32)
        set(name libclang.dll)
    else()
        set(name libclang.so)
    endif()
    set(tools "${CMAKE_BINARY_DIR}/libexec/lyra")
    configure_file("${library}" "${tools}/${name}" COPYONLY)
    install(FILES "${tools}/${name}" DESTINATION libexec/lyra)
    execute_process(COMMAND "${LLVM_TOOLS_BINARY_DIR}/clang${CMAKE_EXECUTABLE_SUFFIX}" -print-resource-dir
        OUTPUT_VARIABLE resource OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT IS_DIRECTORY "${resource}/include")
        message(FATAL_ERROR "Clang resource headers not found: ${resource}/include")
    endif()
    file(COPY "${resource}/include" DESTINATION "${tools}/clang")
    lyra_install_c_headers("${tools}/clang/include" libexec/lyra/clang/include clang-resource-headers)
    lyra_stage_linker("${LLVM_TOOLS_BINARY_DIR}/clang${CMAKE_EXECUTABLE_SUFFIX}" "lyra-clang${CMAKE_EXECUTABLE_SUFFIX}")
    lyra_stage_linker("${LLVM_TOOLS_BINARY_DIR}/llvm-ar${CMAKE_EXECUTABLE_SUFFIX}" "llvm-ar${CMAKE_EXECUTABLE_SUFFIX}")
    lyra_stage_c_headers()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        foreach(package IN ITEMS clang-18 libclang1-18 libclang-common-18-dev)
            if(EXISTS "/usr/share/doc/${package}/copyright")
                install(FILES "/usr/share/doc/${package}/copyright" DESTINATION "share/lyra/licenses/host/${package}")
            endif()
        endforeach()
    endif()
endfunction()

function(lyra_stage_c_headers)
    set(target "${CMAKE_BINARY_DIR}/lib/lyra/target")
    if(WIN32)
        set(source "${LYRA_WINDOWS_SYSROOT}/x86_64-w64-mingw32/include")
        if(NOT IS_DIRECTORY "${source}")
            set(source "${LYRA_WINDOWS_SYSROOT}/include")
        endif()
    else()
        set(LYRA_LINUX_C_HEADERS "" CACHE PATH "Optional complete glibc/Linux C include tree for the native SDK")
        set(source "${LYRA_LINUX_C_HEADERS}")
    endif()
    if(source)
        if(NOT IS_DIRECTORY "${source}")
            message(FATAL_ERROR "Native SDK target headers not found: ${source}")
        endif()
        file(COPY "${source}/" DESTINATION "${target}/include" PATTERN "c++" EXCLUDE)
    else()
        find_program(dpkgQuery NAMES dpkg-query)
        if(NOT dpkgQuery)
            message(FATAL_ERROR "Set LYRA_LINUX_C_HEADERS to a glibc/Linux include tree, or build with the Ubuntu presets.")
        endif()
        execute_process(COMMAND "${dpkgQuery}" -L libc6-dev linux-libc-dev OUTPUT_VARIABLE paths COMMAND_ERROR_IS_FATAL ANY)
        string(REPLACE "\n" ";" paths "${paths}")
        file(MAKE_DIRECTORY "${target}/include")
        foreach(path IN LISTS paths)
            if(path MATCHES "^/usr/include/(.+\\.h)$" AND EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
                set(relative "${CMAKE_MATCH_1}")
                get_filename_component(parent "${relative}" DIRECTORY)
                if(NOT parent IN_LIST headerDirectories)
                    file(MAKE_DIRECTORY "${target}/include/${parent}")
                    list(APPEND headerDirectories "${parent}")
                endif()
                file(COPY_FILE "${path}" "${target}/include/${relative}" ONLY_IF_DIFFERENT)
            endif()
        endforeach()
        foreach(package IN ITEMS libc6-dev linux-libc-dev)
            if(EXISTS "/usr/share/doc/${package}/copyright")
                install(FILES "/usr/share/doc/${package}/copyright" DESTINATION "share/lyra/licenses/host/${package}")
            endif()
        endforeach()
    endif()
    lyra_install_c_headers("${target}/include" lib/lyra/target/include target-c-headers)
endfunction()
