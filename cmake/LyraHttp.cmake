function(lyra_enable_http runtime)
    set(version 9.3.0)
    set(hash 1a2b45cb8dda7082b307d336607023aa65549d6f060da1d246b1313da22b685a)
    set(LYRA_LLHTTP_SOURCE_DIR "$ENV{LYRA_LLHTTP_SOURCE_DIR}" CACHE PATH "Pre-extracted llhttp release source (no network)")
    option(LYRA_LLHTTP_OFFLINE "Refuse to download llhttp when the local cache is empty" OFF)
    if(LYRA_LLHTTP_SOURCE_DIR)
        set(source "${LYRA_LLHTTP_SOURCE_DIR}")
    else()
        if(WIN32)
            set(cache "${CMAKE_BINARY_DIR}/../cache/lyra/toolchain")
        elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
            set(cache "$ENV{XDG_CACHE_HOME}/lyra/toolchain")
        else()
            set(cache "$ENV{HOME}/.cache/lyra/toolchain")
        endif()
        file(MAKE_DIRECTORY "${cache}")
        file(LOCK "${cache}/llhttp-${version}.lock" GUARD FUNCTION TIMEOUT 120)
        set(source "${cache}/llhttp-release-v${version}")
        if(NOT EXISTS "${source}/src/llhttp.c")
            set(archive "${cache}/llhttp-${version}.tar.gz")
            if(NOT EXISTS "${archive}")
                if(LYRA_LLHTTP_OFFLINE OR FETCHCONTENT_FULLY_DISCONNECTED)
                    message(FATAL_ERROR "llhttp ${version} is not cached. Set LYRA_LLHTTP_SOURCE_DIR or prefill ${archive}.")
                endif()
                file(DOWNLOAD "https://codeload.github.com/nodejs/llhttp/tar.gz/refs/tags/release/v${version}" "${archive}.part"
                    EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON TIMEOUT 90)
                file(RENAME "${archive}.part" "${archive}")
            endif()
            file(SHA256 "${archive}" digest)
            if(NOT digest STREQUAL hash)
                message(FATAL_ERROR "Unexpected checksum for ${archive}; expected ${hash}.")
            endif()
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${cache}")
        endif()
    endif()
    file(STRINGS "${source}/include/llhttp.h" components REGEX "^#define LLHTTP_VERSION_(MAJOR|MINOR|PATCH) [0-9]+$")
    if(NOT components STREQUAL "#define LLHTTP_VERSION_MAJOR 9;#define LLHTTP_VERSION_MINOR 3;#define LLHTTP_VERSION_PATCH 0")
        message(FATAL_ERROR "The generated llhttp ${version} release source is required in ${source}.")
    endif()
    add_library(lyraLlhttp STATIC "${source}/src/api.c" "${source}/src/http.c" "${source}/src/llhttp.c")
    target_include_directories(lyraLlhttp PUBLIC "${source}/include")
    set_target_properties(lyraLlhttp PROPERTIES OUTPUT_NAME llhttp ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
    target_sources(${runtime} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/http.cpp" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/http_reactor.cpp"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/http2.cpp")
    target_link_libraries(${runtime} PUBLIC lyraLlhttp)
    install(TARGETS lyraLlhttp ARCHIVE DESTINATION lib)
    install(FILES "${source}/LICENSE" "${source}/LICENSE-MIT" DESTINATION share/lyra/licenses/llhttp)
endfunction()
