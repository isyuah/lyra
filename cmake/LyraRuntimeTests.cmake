set(lyraRuntimeTestComponents managed tasks sqlite lists exceptions context task_errors sync)

function(lyra_build_runtime_tests)
    foreach(component IN LISTS lyraRuntimeTestComponents)
        add_executable(test-${component} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/runtime_${component}.cpp")
        target_link_libraries(test-${component} PRIVATE lyraRuntime)
        set_target_properties(test-${component} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/runtime-tests")
        if(WIN32)
            target_link_options(test-${component} PRIVATE -static)
            install(TARGETS test-${component} RUNTIME DESTINATION runtime-tests)
        endif()
    endforeach()
endfunction()

function(lyra_register_runtime_tests directory)
    foreach(component IN LISTS lyraRuntimeTestComponents)
        add_test(NAME runtime-${component} COMMAND "${directory}/test-${component}${CMAKE_EXECUTABLE_SUFFIX}")
        set_tests_properties(runtime-${component} PROPERTIES TIMEOUT 45)
    endforeach()
    add_test(NAME runtime-tasks-single-worker COMMAND "${directory}/test-tasks${CMAKE_EXECUTABLE_SUFFIX}" --single-worker)
    set_tests_properties(runtime-tasks-single-worker PROPERTIES TIMEOUT 45 ENVIRONMENT "LYRA_PARALLEL_WORKERS=1")
endfunction()
