include(${CMAKE_CURRENT_LIST_DIR}/LyraHttp.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/LyraToml.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/LyraRuntimeTests.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/LyraTls.cmake)

function(lyra_add_runtime)
    set(runtime "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime")
    set(include "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include")
    set(sources core strings text time managed tasks io io_args process signals sqlite sqlite_api json lists errors exceptions context net sync reflection backtrace)
    list(TRANSFORM sources PREPEND "${runtime}/")
    list(TRANSFORM sources APPEND ".cpp")
    add_library(lyraRuntime STATIC ${sources})
    lyra_enable_http(lyraRuntime)
    lyra_enable_toml(lyraRuntime)
    target_compile_options(lyraRuntime PRIVATE -fno-exceptions -fno-rtti)
    target_include_directories(lyraRuntime PUBLIC "${runtime}" PRIVATE "${include}")
    set_target_properties(lyraRuntime PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
    if(WIN32)
        set(CMAKE_MAP_IMPORTED_CONFIG_DEBUG Release)
        find_package(BDWgc CONFIG REQUIRED)
        find_package(libuv CONFIG REQUIRED)
        find_package(jansson CONFIG REQUIRED)
        find_package(unofficial-sqlite3 CONFIG REQUIRED)
        set(libraries BDWgc::gc libuv::uv_a jansson::jansson unofficial::sqlite3::sqlite3)
        set(names libgc.a libuv.a libjansson.a libsqlite3.a)
        foreach(library name IN ZIP_LISTS libraries names)
            get_target_property(archive "${library}" IMPORTED_LOCATION_RELEASE)
            install(FILES "${archive}" DESTINATION lib RENAME "${name}")
        endforeach()
        get_target_property(archive BDWgc::gc IMPORTED_LOCATION_RELEASE)
        get_filename_component(prefix "${archive}/../.." ABSOLUTE)
        foreach(port IN ITEMS bdwgc libuv jansson sqlite3)
            install(FILES "${prefix}/share/${port}/copyright" DESTINATION "share/lyra/licenses/${port}")
        endforeach()
        target_compile_definitions(lyraRuntime PRIVATE GC_NOT_DLL)
        target_link_libraries(lyraRuntime PUBLIC ${libraries} dbghelp ws2_32 iphlpapi userenv psapi advapi32 user32 ole32 shell32)
    else()
        find_package(Threads REQUIRED)
        find_package(SQLite3 REQUIRED)
        find_library(gcArchive NAMES libgc.a REQUIRED)
        find_library(uvArchive NAMES libuv.a libuv_a.a REQUIRED)
        find_library(jsonArchive NAMES libjansson.a REQUIRED)
        find_library(sqliteArchive NAMES libsqlite3.a REQUIRED)
        lyra_stage_sdk_input("${gcArchive}" lib/libgc.a)
        lyra_stage_sdk_input("${uvArchive}" lib/libuv.a)
        lyra_stage_sdk_input("${jsonArchive}" lib/libjansson.a)
        lyra_stage_sdk_input("${sqliteArchive}" lib/libsqlite3.a)
        foreach(archive IN ITEMS "${gcArchive}" "${uvArchive}" "${jsonArchive}" "${sqliteArchive}")
            lyra_install_linux_notice("${archive}")
        endforeach()
        target_include_directories(lyraRuntime PRIVATE ${SQLite3_INCLUDE_DIRS})
        target_link_libraries(lyraRuntime PUBLIC "${sqliteArchive}" "${gcArchive}" "${uvArchive}" "${jsonArchive}" Threads::Threads ${CMAKE_DL_LIBS} rt m)
    endif()
    lyra_add_tls()
    install(TARGETS lyraRuntime ARCHIVE DESTINATION lib)
    if(BUILD_TESTING)
        lyra_build_runtime_tests()
    endif()
endfunction()
