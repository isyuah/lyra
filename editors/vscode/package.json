{
  "name": "lyra-language",
  "displayName": "Lyra Language",
  "description": "Editor support for Lyra with the native Lyra SDK.",
  "version": "0.1.0",
  "publisher": "lyra-lang",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Lyra analyzes project manifests, dependencies, and declared macro inputs in the workspace."
    },
    "virtualWorkspaces": false
  },
  "main": "./extension.cjs",
  "activationEvents": ["workspaceContains:**/lyra.json5", "onDebugResolve:lyra", "onDebugInitialConfigurations:lyra"],
  "scripts": {
    "check": "node --check extension.cjs && node --check testing.cjs"
  },
  "contributes": {
    "commands": [
      { "command": "lyra.tests.refresh", "title": "Lyra: Refresh Tests" }
    ],
    "debuggers": [
      {
        "type": "lyra",
        "label": "Lyra",
        "languages": ["lyra"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "Native executable built with --debug-info." },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "stopOnEntry": { "type": "boolean" }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lyra",
            "request": "launch",
            "name": "Lyra: Launch Debug Build",
            "program": "${workspaceFolder}/build/debug/app",
            "cwd": "${workspaceFolder}",
            "args": []
          }
        ]
      }
    ],
    "configuration": {
      "title": "Lyra",
      "properties": {
        "lyra.serverPath": {
          "type": "string",
          "default": "lyra",
          "scope": "machine",
          "description": "Lyra SDK executable (absolute path or a name on PATH). Reload the window after changing it."
        },
        "lyra.debugAdapterPath": {
          "type": "string",
          "default": "lldb-dap",
          "scope": "machine",
          "description": "LLDB DAP executable (absolute path or a name on PATH)."
        }
      }
    },
    "languages": [
      {
        "id": "lyra",
        "aliases": [
          "Lyra"
        ],
        "extensions": [
          ".ly"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lyra-manifest",
        "aliases": ["Lyra Manifest"],
        "filenames": ["lyra.json5"],
        "configuration": "./manifest-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lyra",
        "scopeName": "source.lyra",
        "path": "./syntaxes/lyra.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.lyra": "lyra"
        }
      },
      {
        "language": "lyra-manifest",
        "scopeName": "source.lyra-manifest",
        "path": "./syntaxes/lyra-manifest.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
